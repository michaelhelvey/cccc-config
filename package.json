{
  "name": "@michaelhelvey/cccc-config",
  "version": "0.1.1",
  "description": "Cognitive and cyclomatic complexity checks for TypeScript (and more), configured with an ESLint-style flat config and powered by the cccc Rust engine through bun:ffi",
  "keywords": [
    "complexity",
    "cognitive-complexity",
    "cyclomatic-complexity",
    "lint",
    "typescript",
    "bun",
    "cli"
  ],
  "homepage": "https://github.com/michaelhelvey/cccc-config#readme",
  "bugs": {
    "url": "https://github.com/michaelhelvey/cccc-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelhelvey/cccc-config.git"
  },
  "license": "MIT",
  "author": "Michael Helvey",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cccc-config": "bin/cccc-config.ts"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "dist/types",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/src"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "rs hooks",
    "postinstall": "bun run build:native",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml",
    "build:types": "rm -rf dist/types && tsc -p tsconfig.build.json",
    "complexity": "bun bin/cccc-config.ts",
    "format": "rs fmt",
    "lint": "rs lint --fix",
    "check": "rs check --type-check",
    "validate": "bun run format && bun run lint && bun run check && bun test",
    "prepack": "bun run build:types"
  },
  "dependencies": {
    "minimatch": "^10.2.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "rstack": "^0.8.3",
    "typescript": "^7.0.2"
  }
}
